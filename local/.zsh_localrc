# build and run apollo service
function service_run() (
  echo_exec() { echo $(tput setaf 2)'$' ${@}$(tput sgr0); $@; }
  local service_name=$($HOME/.pyenv/shims/yq -rc ".facts.service_discovery[0]" service-info.yaml)
  if [ -z ${service_name+x} ]; then
    echo "missing service discovery:"
    cat service-info.yaml
  else
    local jar=$(find target/ -name "*${service_name}.jar" | grep . || find target/ -name "*${service_name}*.jar")
    echo_exec mvn package -T 1C -Dmaven.test.skip -Ddockerfile.skip -Dmdep.analyze.skip -Dfindbugs.skip -Dspotbugs.skip -Djacoco.skip -Dfmt.skip -Denforcer.skip -PuberJar && echo_exec java -jar $jar
  fi
)
function mvn_run() (
  echo_exec() { echo $(tput setaf 2)'$' ${@}$(tput sgr0); $@; }
  echo_exec mvn package -T 2C -Dmaven.test.skip -Ddockerfile.skip -Dmdep.analyze.skip -Dfindbugs.skip -Dspotbugs.skip -Djacoco.skip -Dfmt.skip -Denforcer.skip && echo_exec mvn exec:java
)
function jib() (
  echo_exec() { echo $(tput setaf 2)'$' ${@}$(tput sgr0); $@; }
  local service_name=$($HOME/.pyenv/shims/yq -rc ".facts.service_discovery[0]" service-info.yaml)
  if [ -z ${service_name+x} ]; then
    echo "missing service discovery:"
    cat service-info.yaml
  else
    echo_exec \
      mvn package -T 2C jib:dockerBuild -Dmaven.test.skip -Dmdep.analyze.skip -Dfindbugs.skip -Dspotbugs.skip -Djacoco.skip -Dfmt.skip -Denforcer.skip \
      && echo && \
    echo_exec \
      docker run --rm --network host \
        -p 8080:8080 -p 5990:5990 \
        -e SPOTIFY_DOMAIN=$SPOTIFY_DOMAIN \
        -v $HOME/.config/gcloud:/root/.config/gcloud \
        -v $PWD/${service_name}-user.conf:/etc/spotify/${service_name}.conf \
        -v $PWD/logback-local.xml:/logback-local.xml \
        $(jq -r '.image' target/jib-image.json)
  fi
)
function bazel_run() (
  echo_exec() { echo $(tput setaf 2)'$' ${@}$(tput sgr0); $@; }
  echo_exec baz run
)
function run() (
  local pomfile="pom.xml"
  local bazelfile="BUILD.bazel"
  local wrong_dir=false
  local cmd="mvn"
  if [ -e "$PWD/$pomfile" ]; then
    cmd="mvn_run"
  elif [ -e "$PWD/$bazelfile" ]; then
    cmd="bazel_run"
  else
    local gitroot=$(grootdir)
    local relative_groot=$(realpath -s --relative-to="$PWD" "$gitroot")
    if [ -e "$gitroot/$pomfile" ]; then
      wrong_dir=true
      cmd="mvn_run"
    elif [ -e "$gitroot/$bazelfile" ]; then
      wrong_dir=true
      cmd="bazel_run"
    else
      echo "I can't run this project."
      return 1
    fi
  fi
  if [[ "$wrong_dir" == true && "${cmd}" != "bazel_run" ]]; then
    echo "not in root of project"
    echo "running from projectroot: (cd $relative_groot && $cmd $@)"
    (cd $relative_groot && $cmd $@)
  else
    $cmd $@
  fi
)

function build() {
  local pomfile="pom.xml"
  local sbtfile="build.sbt"
  local bazelfile="BUILD.bazel"
  local wrong_dir=false
  local default_command="package"
  local default_bazel_command="build"
  local tool="mvn"
  if [ -e "$PWD/$pomfile" ]; then
    tool="mvn"
  elif [ -e "$PWD/$sbtfile" ]; then
    tool="sbt"
  elif [ -e "$PWD/$bazelfile" ]; then
    tool="baz"
  else
    local gitroot=$(git rev-parse --show-toplevel)
    local relative_groot=$(realpath -s --relative-to="$PWD" "$gitroot")
    if [ -e "$gitroot/$pomfile" ]; then
      tool="mvn"
      wrong_dir=true
    elif [ -e "$gitroot/$sbtfile" ]; then
      tool="sbt"
      wrong_dir=true
    elif [ -e "$gitroot/$bazelfile" ]; then
      tool="baz"
      wrong_dir=true
    else
      echo "I can't build this project."
      return 1
    fi
  fi
  local args=()
  local newarg=""
  for arg in "$@"; do
    case "$arg" in
      v|ver|verif)
        newarg="verify"
        ;;
      c|cl|claen|clena)
        newarg="clean"
        ;;
      co|com|comp)
        newarg="compile"
        ;;
      p|pack)
        newarg="package"
        ;;
      b)
        newarg="build"
        ;;
      r)
        newarg="run"
        ;;
      t)
        newarg="test"
        ;;
      i|in|inst)
        newarg="install"
        ;;
      cv)
        newarg="clean verify"
        ;;
      cp)
        newarg="clean package"
        ;;
      cc)
        newarg="clean compile"
        ;;
      *)
        newarg="$arg"
        ;;
    esac
    args+=($newarg)
  done
  if [[ ${#args[@]} -eq 0 || (${#args[@]} -eq 1 && ${args[1]} = "clean") ]]; then
    if [[ "${tool}" == "bazel" || "${tool}" == "baz" ]]; then
      args+=($default_bazel_command)
    else
      args+=($default_command)
    fi
  fi
  if [[ "${tool}" == "bazel" ]]; then
    args+=(".")
  fi
  if [[ "$wrong_dir" == true && "${tool}" != "baz" ]]; then
    echo "not in root of project"
    echo "running from projectroot: (cd $relative_groot && $tool ${args[@]})"
    (cd $relative_groot && $tool "${args[@]}")
    # TODO: move this to a function to get `print -z` support 
    # print -z "(cd $relative_groot && $tool ${args[@]})"
  else
    echo "$tool "${args[@]}"" | bat --color=always --style plain --language sh --theme ansi
    $tool "${args[@]}"
  fi
}

