# monorepo
export monodir="$HOME/workspace/services-pilot"
# alias mono="cd $monodir"
alias monorepo="cd $monodir"
# go to project within monorepo
function mono() {
  # cd "$@"
  if [ $# -eq 0 ]; then
    cd "${monodir}"
  else
    cd "${monodir}/$1"
  fi
}
function _mono() {
  # _files -/ -g "${monodir}/*/*"
  _files -/ -W "${monodir}/" -g "*/*(-/)"
}
compdef _mono mono
alias monorepo_grootdir='echo $(git rev-parse --show-toplevel)/${${$(git rev-parse --show-prefix)%/}:h2}'
alias grootdir='if [[ $(git rev-parse --show-toplevel) == *"services-pilot"* ]]; then monorepo_grootdir; else git rev-parse --show-toplevel; fi'
# alias groot='$(git rev-parse --show-toplevel)/${$(git rev-parse --show-prefix):h2}'
# bazel
function monorepo_target_from_dir() {
  local pwd=${PWD}
  local relative_dir=${pwd/(#b)(*)services-pilot\//}
  local split=(${(s[/])relative_dir})
  local org=${split[1]}
  local project=${split[2]}
  echo "${org}/${project}"
}
function baztarget() {
  local target="$(monorepo_target_from_dir)"
  bazel "$@" "//${target}"
}
function bazdots() {
  local target="$(monorepo_target_from_dir)/..."
  bazel "$@" "//${target}"
}
function bazdot() {
  bazel "$@" "."
}
function baz() {
  if [[ "$1" == "test" ]]; then
    bazdots "$@"
  else
    baztarget "$@"
  fi
}
alias monotarget='monorepo_target_from_dir'
alias monorun='baz run'
alias monotest='bazel test //$(monotarget)/...'
alias monoformat='bazel run //:format -- $(monotarget)'
alias format='monoformat'
