# jhurl
# alias to https://ghe.spotify.net/miq/spotify-developer-cli dockerized jhurl so I don't have to install with brew
# function jhurl() {
#   sp jhurl --site services.guc3.spotify.net --catalogue premium --country US --user-header Accept=application/json --user-header Content-Type=application/json "$@"
# }
function jhq() {
  # args=$(printf '"%s"\0' "$@")
  jh "$@" -p | jq . || jh "$@" -p --pbjson | jq .
}
alias jhurl="jh"
alias jqh="jhq"
alias jhqp="jhq --pbjson"
# alias jhql="jhq -z 'tcp://localhost:5700'"
# alias jhqpl="jhqp -z 'tcp://localhost:5700'"
alias jhql="jhq --local"
alias jhqpl="jhqp --local"
alias jhqlp="jhql --pbjson"
function userdata() {
  user_name_or_id=${1:-$USER_ID}
  spgrpcurl -H "SERVICE":"adhoc-user-flundin" -d '{"identifier":{"username":"'"$user_name_or_id"'"}, "requested_identifiers": ["USER_ID", "USERNAME"], "requested_attributes": ["employee", "country", "email"]}' useraccount com.spotify.useraccount.v1.UserAccount.GetAccount 2>/dev/null || spgrpcurl -H "SERVICE":"adhoc-user-flundin" -d '{"identifier":{"user_id":"'"$user_name_or_id"'"}, "requested_identifiers": ["USER_ID", "USERNAME"], "requested_attributes": ["employee", "country", "email"]}' useraccount com.spotify.useraccount.v1.UserAccount.GetAccount
  # $HOME/workspace/useraccount/lookup.sh '{"identifier":{"username":"'"$1"'"}, "requested_identifiers": ["USER_ID", "USERNAME"]}' || $HOME/workspace/useraccount/lookup.sh '{"identifier":{"user_id":"'"$1"'"}, "requested_identifiers": ["USER_ID", "USERNAME"]}'
  # jhq "hm://userdata/account?username=${1}" | jq . -e || jh "hm://userdata/account?user_id=${1}" | jq . -e
}

function userargs() {
  user_name_or_id=${1:-$USER_ID}
  response=$(userdata $user_name_or_id)
  user_id=$(echo $response | jq '.account.identifiers.user_id' -r)
  user_name=$(echo $response | jq '.account.identifiers.username' -r)
  echo --userid $user_id --username $user_name
}

# ghe
alias ghr="GH_HOST=ghe.spotify.net gh"

# pip artifactory
function pip() {
  if [[ "$1" == "spotinstall" ]]; then
    shift 1
    command pip install --extra-index-url=https://artifactory.spotify.net/artifactory/api/pypi/pypi/simple "$@"
  else
    command pip "$@"
  fi
}
# pipx artifactory
function pipx() {
  if [[ "$1" == "spotinstall" ]]; then
    shift 1
    command pipx install --index-url=https://artifactory.spotify.net/artifactory/api/pypi/pypi/simple "$@"
  else
    command pipx "$@"
  fi
}

